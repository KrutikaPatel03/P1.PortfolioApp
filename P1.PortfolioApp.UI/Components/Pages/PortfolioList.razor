@page "/"
@using P1.PortfolioApp.UI.Components.Custom
@using P1.PortfolioApp.UI.Services
@using P1.PortfolioApp.Core.Models

@inject PortfolioApiClient PortfolioApi
@inject NavigationManager Navigation
<PageTitle>Portfolios</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0">Portfolio Management</h2>
        <small class="text-muted">
            Manage and view client portfolios
        </small>
    </div>
</div>

@if (loading)
{
    <LoadingSpinner />
}
else
{
    <div class="card shadow-sm">

        <div class="card-header custom-header text-white">
            <div class="d-flex justify-content-between align-items-center">

                <div class="card-header custom-header">
                    Portfolios
                </div>

                <span class="badge bg-light text-dark">
                    @portfolios.Count Portfolio(s)
                </span>

            </div>
        </div>

        <div class="card-body">
            <div class="list-group">

                @foreach (var portfolio in PagedPortfolios)
                {
                    <div class="list-group-item portfolio-item border-start border-2 rounded shadow-sm mb-3 p-4">
                        <div class="row align-items-center">

                            <!-- Client -->
                            <div class="col-md-3">

                                <div class="d-flex align-items-center">

                                    <div class="client-avatar">
                                        @GetClientInitials(portfolio.ClientName)
                                    </div>

                                    <div class="ms-3">

                                        <h5 class="mb-1 client-name">
                                            @portfolio.ClientName
                                        </h5>

                                        <small class="text-muted">
                                            @portfolio.ClientId
                                        </small>

                                    </div>

                                </div>

                            </div>

                            <div class="col-md-3">
                                <small class="text-muted d-block">Current Value</small>
                                <h5 class="mb-0 text-theme">
                                    @portfolio.CurrentValue.ToString("C")
                                </h5>
                            </div>

                            <div class="col-md-2">
                                <small class="text-muted d-block">Cash Balance</small>
                                <h5 class="mb-0 text-success">
                                    @portfolio.CashBalance.ToString("C")
                                </h5>
                            </div>

                            <div class="col-md-2">
                                <small class="text-muted d-block">Accounts</small>
                                <h5 class="mb-0">
                                    @portfolio.Accounts
                                </h5>
                            </div>
                            <!-- Action -->
                            <div class="col-md-2 d-flex justify-content-end">
                                <a title="View Portfolio"
                                   href="@($"/portfolio/{portfolio.ClientId}")"
                                   class="btn portfolio-action-btn">

                                    <i class="bi bi-chevron-right"></i>

                                </a>
                            </div>

                        </div>

                    </div>
                }

            </div>

            <div class="mt-4">
                <Pagination CurrentPage="@currentPage"
                            TotalPages="@totalPages"
                            CurrentPageChanged="ChangePage" />
            </div>

        </div>

    </div>
}

<ErrorAlert Message="@errorMessage" />

@code {

    private List<PortfolioSummary> portfolios = [];

    private bool loading = true;

    private string errorMessage = "";

    private int currentPage = 1;

    private int pageSize = 5;

    private int totalPages =>
        portfolios == null
            ? 0
            : (int)Math.Ceiling(
                (double)portfolios.Count /
                pageSize);

    private IEnumerable<PortfolioSummary> PagedPortfolios =>
        portfolios
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
        ?? [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadPortfolioData();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }

        loading = false;
    }
    private async Task LoadPortfolioData()
    {
        portfolios = await PortfolioApi
            .GetPortfoliosAsync();
    }
    private async Task ChangePage(int page)
    {
        currentPage = page;
        await LoadPortfolioData();
    }
    private static string GetClientInitials(string? clientName)
    {
        if (string.IsNullOrWhiteSpace(clientName))
            return "";

        var names = clientName
            .Split(' ', StringSplitOptions.RemoveEmptyEntries);

        if (names.Length == 1)
            return names[0][0].ToString().ToUpper();

        return $"{names[0][0]}{names[1][0]}".ToUpper();
    }

}